{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".expo/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "gen:contract": {
      "cache": false
    },
    "dev:backend": {
      "cache": false,
      "persistent": true
    },
    "dev:dashboard": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    }
  }
}